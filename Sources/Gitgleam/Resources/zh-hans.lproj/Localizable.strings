/* Settings window: rows */
"Language" = "语言";
"The language Gitgleam's menu and windows are displayed in." = "Gitgleam 菜单和窗口所使用的显示语言。";
"Automatic (System Language)" = "自动（系统语言）";
"Choose…" = "选择…";
